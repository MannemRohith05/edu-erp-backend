PORT=8080
DB_URL=jdbc:mysql://localhost:3306/edu_erp
DB_USERNAME=root
DB_PASSWORD=replace-with-your-mysql-password
JWT_SECRET=replace-with-a-random-base64-secret-at-least-32-bytes
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION=604800000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address
MAIL_PASSWORD=your-gmail-app-password
FRONTEND_URL=http://localhost:5173
DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
APP_ACADEMIC_GRADE_POINTS=A+=10,A=9,B=8,C=7,D=6,F=0
# Optional, only when explicitly enabling demo-data initialization.
DEMO_PASSWORD=
DEMO_ADMIN_EMAIL=admin@example.invalid
# Optional one-time Super Admin bootstrap. Do not commit actual values.
SUPER_ADMIN_FIRST_NAME=replace-with-super-admin-first-name
SUPER_ADMIN_LAST_NAME=Super Admin
SUPER_ADMIN_EMAIL=replace-with-super-admin-email
SUPER_ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password
